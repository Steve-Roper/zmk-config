#include "keyve.dtsi"
#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,matrix-transform = &keyve_right_transform;
        zmk,physical-layout = &keyve_right_layout;
    };

    keyve_right_transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        rows = <5>;
        columns = <6>;

        /*
         * Visual layout:
         * 6   7  8  9    0    +
         * Y   U  I  O    P    Å
         * H   J  K  L    Ö    Ä
         * N   M  ,  .    -    '
         * RET       PGUP PGDN DEL
         */

        map = <
          RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)
          RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)
          RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)
          RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)
          RC(4,0)                 RC(4,3) RC(4,4) RC(4,5)
        >;
    };

    keyve_right_layout: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Keyve Right";
        transform = <&keyve_right_transform>;
        kscan = <&kscan0>;
    };
};