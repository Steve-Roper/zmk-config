#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                /* Left half */
                &kp GRAVE  &kp N1    &kp N2    &kp N3  &kp N4  &kp N5
                &kp TAB    &kp Q     &kp W     &kp E   &kp R   &kp T
                &kp ESC    &kp A     &kp S     &kp D   &kp F   &kp G
                &kp LSHFT  &kp Z     &kp X     &kp C   &kp V   &kp B
                &kp LCTRL  &kp LGUI  &kp LALT                  &kp SPACE

                /* Right half */
                &kp N6   &kp N7  &kp N8     &kp N9     &kp N0     &kp EQUAL
                &kp Y    &kp U   &kp I      &kp O      &kp P      &kp LBKT
                &kp H    &kp J   &kp K      &kp L      &kp SEMI   &kp SQT
                &kp N    &kp M   &kp COMMA  &kp DOT    &kp MINUS  &kp BSLH
                &kp RET                    &kp PG_UP  &kp PG_DN  &kp DEL
            >;
        };
    };
};